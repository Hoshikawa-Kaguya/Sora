<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Sora.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Sora\Sora.csproj"/>
        <ProjectReference Include="..\..\src\Sora.Adapter.OneBot11\Sora.Adapter.OneBot11.csproj"/>
        <ProjectReference Include="..\..\src\Sora.Adapter.Milky\Sora.Adapter.Milky.csproj"/>
        <ProjectReference Include="..\Sora.LoggingProbe\Sora.LoggingProbe.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="coverlet.collector"/>
    </ItemGroup>

    <Target Name="CopyLoggingProbe" AfterTargets="Build">
        <ItemGroup>
            <LoggingProbeFiles Include="..\Sora.LoggingProbe\bin\$(Configuration)\$(TargetFramework)\**\*"/>
        </ItemGroup>
        <Copy SourceFiles="@(LoggingProbeFiles)"
              DestinationFiles="@(LoggingProbeFiles->'$(OutDir)LoggingProbe\%(RecursiveDir)%(Filename)%(Extension)')"/>
    </Target>

</Project>
